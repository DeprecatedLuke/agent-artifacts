# Site values (see README "Deploy"). Copy to .env (mode 600, gitignored) and fill in.
ARTIFACTS_HOST=artifacts.example.com
ARTIFACTS_PUBLIC_URL=https://artifacts.example.com
ARTIFACTS_REGISTRY=ghcr.io/your-user
ACME_EMAIL=you@example.com
# Empty = current kubectl context.
ARTIFACTS_KUBE_CONTEXT=
# Image pull Secret in the artifacts namespace (`task secrets` copies it there).
ARTIFACTS_PULL_SECRET=registry-credentials

# Secrets: openssl rand -hex 32 for the two tokens.
ARTIFACTS_SESSION_TOKEN=
ARTIFACTS_OWNER_SECRET=
ARTIFACTS_BASIC_AUTH_USER=
ARTIFACTS_BASIC_AUTH_PASSWORD=
